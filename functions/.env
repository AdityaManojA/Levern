# Public settings for the TaskFlow server (not secrets). The client secret is a Functions secret:
#   firebase functions:secrets:set GOOGLE_CLIENT_SECRET
GOOGLE_CLIENT_ID=
PUBLIC_URL=https://taskflow-dailytracker.web.app
# sites sharing this server and sign-in; each needs its own redirect URI <site>/api/gcal/callback in the OAuth client
ALLOWED_ORIGINS=https://taskflow-dailytracker.web.app,https://taskflow-solodesk.web.app

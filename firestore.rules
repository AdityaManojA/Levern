rules_version = '2';
// Firestore rules are owned and deployed by Solodesk (Solodesk-MVP/firestore.rules); this is a copy for
// reference and is NOT in TaskFlow's firebase.json, so deploying TaskFlow never replaces them.
// TaskFlow's server uses admin access and needs no rules; everything TaskFlow stores (users/*, feeds/*,
// oauthStates/*) stays closed to browsers because nothing below allows it.
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user can read/write only their own workspace document.
    match /solodeskWorkspaces/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}

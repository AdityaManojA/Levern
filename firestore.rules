rules_version = '2';
// Firestore rules for the shared project (TaskFlow + Solodesk). Solodesk deploys them
// (Solodesk-MVP/firestore.rules); keep this file and Solodesk's the same.
service cloud.firestore {
  match /databases/{database}/documents {
    // Solodesk: each signed-in user can read/write only their own workspace document.
    match /solodeskWorkspaces/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Client portal snapshots are separate from private owner workspaces.
    match /solodeskPortals/{owner}/shares/{client} {
      allow read: if request.auth != null && (request.auth.uid == owner ||
        (exists(/databases/$(database)/documents/solodeskWorkspaces/$(owner)) &&
          (resource.data.recipientUid == request.auth.uid ||
            (request.auth.token.get('email_verified', false) == true &&
             resource.data.recipientEmail == request.auth.token.get('email', '').lower()))));
      allow create, update: if request.auth != null && request.auth.uid == owner &&
        request.resource.data.keys().hasOnly(['ownerUid','clientId','recipientUid','recipientEmail','projectIds','invoiceIds','data']) &&
        request.resource.data.ownerUid == owner && request.resource.data.clientId == client &&
        request.resource.data.recipientUid is string && request.resource.data.recipientEmail is string;
      allow delete: if request.auth != null && request.auth.uid == owner;
    }
    // TaskFlow: each signed-in user can read/write only their own TaskFlow data (sync chunks and the
    // share/open summary Solodesk reads). Same uid, so Solodesk can read it for the same person.
    match /taskflowUsers/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /taskflowUsers/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // TaskFlow leaderboard: a name, all-time EXP and this season's EXP for people who chose to show on the
    // board (off by default). Anyone signed in can read it; only the owner writes their own entry.
    // EXP is worked out in the app (no server code on the free plan), so these rules cap how fast it can grow:
    // a bucket of at most 60 EXP that refills 15 an hour. Real use earns less (30 a day from quests, 12 an hour
    // from nonstop focus). A new entry starts at most at 3000 EXP. Leaving the board hides the entry (name
    // cleared, hidden: true) rather than deleting it, so the cap can't be reset by leaving and rejoining.
    // Seasons are two weeks from 19 Oct 2026 00:00 UTC (1792368000000 ms), as in TaskFlow's stats.js.
    function tfSeasonNow() {
      return int((request.time.toMillis() - 1792368000000) / 1209600000) + 1;
    }
    function tfBoardShape(d) {
      return d.keys().hasOnly(['name', 'exp', 'season', 'seasonExp', 'bank', 'hidden', 'updated'])
        && d.name is string && d.name.size() <= 30
        && !d.name.lower().matches('.*(fuck|cunt|nigg|fagg|whore|bitch|motherf|asshole|dickhead|cocksuck|retard|tranny|chutiya|madarchod|bhenchod|behenchod|bhosdi|thayoli|thaayoli|thallipoli|pundachi|kandaroli|poorimon|pulayadi|thevidiya).*')
        && d.exp is int && d.exp >= 0
        && d.season is int && (d.season == tfSeasonNow() || d.season == tfSeasonNow() - 1)
        && d.seasonExp is int && d.seasonExp >= 0 && d.seasonExp <= d.exp
        && d.bank is number && d.bank >= 0 && d.bank <= 60
        && d.hidden is bool
        && d.updated == request.time;
    }
    // n: the new entry, o: the entry as it was
    function tfBoardGrowth(n, o) {
      let room = o.get('bank', 0) + 15 * (request.time.toMillis() - o.updated.toMillis()) / 3600000;
      let delta = n.exp - o.exp;
      let sameSeason = n.season == o.get('season', 0);
      return n.season >= o.get('season', 0) && (
        (delta <= 0 && n.bank <= room
          && ((sameSeason && n.seasonExp <= o.get('seasonExp', 0)) || (!sameSeason && n.seasonExp == 0)))
        || (delta > 0 && n.bank <= room - delta
          && ((sameSeason && n.seasonExp <= o.get('seasonExp', 0) + delta) || (!sameSeason && n.seasonExp <= delta))));
    }
    match /taskflowBoard/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid
        && tfBoardShape(request.resource.data)
        && request.resource.data.exp <= 3000 && request.resource.data.seasonExp <= 420 && request.resource.data.bank == 0;
      allow update: if request.auth != null && request.auth.uid == uid
        && tfBoardShape(request.resource.data) && tfBoardGrowth(request.resource.data, resource.data);
      allow delete: if false;
    }
  }
}
